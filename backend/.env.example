# StockMind AI Environment Configuration

# Application
APP_NAME=StockMind AI
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security / Authentication (JWT)
JWT_SECRET_KEY=stockmind_ai_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to local SQLite for instant zero-config setup, or PostgreSQL / Supabase Postgres URI
DATABASE_URL=sqlite:///./stockmind.db
# Example for Supabase or external PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Optional External Data Providers (yfinance is active out-of-the-box without keys)
# Alpha Vantage API Key (Optional)
ALPHA_VANTAGE_API_KEY=
# Finnhub API Key (Optional)
FINNHUB_API_KEY=
# Twelve Data API Key (Optional)
TWELVE_DATA_API_KEY=

# Optional AI LLM Integration (DeepSeek / OpenAI / Gemini for natural language synthesis)
# Rule-based algorithmic synthesis is built-in and always active!
OPENAI_API_KEY=
GEMINI_API_KEY=

